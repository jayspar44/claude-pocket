# Relay Server Configuration
# Copy this file to .env and fill in your values

# Server port
PORT=4501
HOST=0.0.0.0

# Claude Code command (if not in PATH)
CLAUDE_COMMAND=claude

# Antigravity CLI command (if not in PATH)
ANTIGRAVITY_COMMAND=agy

# NOTE: there is no ALLOWED_ORIGINS setting. CORS is deliberately open - see the
# comment in relay/src/index.js. Older hosts may still have the variable in
# their .env or baked into PM2's captured env; it is read by nothing.

# Maximum concurrent CLI instances (PTY processes). The app reads this from
# /api/health and refuses to create more tabs than the relay will accept.
MAX_INSTANCES=10

# Shell to use (defaults to $SHELL)
# SHELL=/bin/zsh

# Node environment
NODE_ENV=development
