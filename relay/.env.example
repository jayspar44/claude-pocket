# Relay Server Configuration
# Copy this file to .env and fill in your values

# Server port
PORT=4501
HOST=0.0.0.0

# Claude Code command (if not in PATH)
CLAUDE_COMMAND=claude

# Antigravity CLI command (if not in PATH)
ANTIGRAVITY_COMMAND=agy

# CORS allowed origins (comma-separated). '*' or unset allows any origin.
#
# The relay authenticates nobody, so an explicit list is the only thing stopping
# a page you happen to visit from reading /api/files/* out of this host. The
# default stays '*' because tightening it would lock out APKs already on phones.
#
# A locked-down list must name EVERY origin that talks to this relay:
#   http://localhost:4500           web app, PROD folder
#   http://localhost:4502           web app, DEV folder
#   http://<tailscale-host>:4500    web app over the tailnet (:4502 for DEV)
#   https://localhost               the Android APK - capacitor.config.json sets
#                                   androidScheme "https", so it is NOT
#                                   capacitor://localhost
ALLOWED_ORIGINS=*

# Maximum concurrent CLI instances (PTY processes). The app reads this from
# /api/health and refuses to create more tabs than the relay will accept.
MAX_INSTANCES=10

# Shell to use (defaults to $SHELL)
# SHELL=/bin/zsh

# Node environment
NODE_ENV=development
